{
  "name": "duo-agent",
  "displayName": "Duo Agent",
  "description": "Let two Cursor IDE instances collaborate on any task together via a shared MCP server.",
  "version": "0.0.6",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "duo-agent.startServer",
        "title": "Duo Agent: Start MCP Server"
      },
      {
        "command": "duo-agent.stopServer",
        "title": "Duo Agent: Stop MCP Server"
      },
      {
        "command": "duo-agent.openPanel",
        "title": "Duo Agent: Open Panel"
      },
      {
        "command": "duo-agent.openControlTerminal",
        "title": "Duo Agent: Open Session Terminal"
      },
      {
        "command": "duo-agent.installProtocolRules",
        "title": "Duo Agent: Install Protocol Rules"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "duo-agent-sidebar",
          "title": "Duo Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "duo-agent-sidebar": [
        {
          "type": "webview",
          "id": "duo-agent.panel",
          "name": "Duo Agent"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "digest": "node ./out/duoDigestCli.js",
    "check-contracts": "node scripts/check-contracts.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {}
}
